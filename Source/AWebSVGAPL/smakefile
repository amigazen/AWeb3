## SAS/C makefile for awebsvg aweb plugin module

# Compiler and flags
CC=sc
CFLAGS= NOSTKCHK PARMS=REG OPTIMIZE OPTGO OPTPEEP OPTINLOCAL OPTINL\
        OPTLOOP OPTRDEP=4 OPTDEP=4 OPTCOMP=4

# Linker and flags
LN=slink
LDFLAGS= SD ND BATCH

# Library tools
AR=oml
RM=delete quiet

# Main plugin object files
PLUGIN_OBJS = startup.o awebsvg.o svgsource.o svgcopy.o svgtext.o xmlparse.o

# Default target
all: awebsvg.awebplugin

# Build the main plugin
awebsvg.awebplugin: $(PLUGIN_OBJS) awebsvg.lnk
   $(LN) with awebsvg.lnk

# Individual object file rules
startup.o: startup.c pluginlib.h
   $(CC) startup.c

awebsvg.o: awebsvg.c pluginlib.h awebsvg.h
   $(CC) awebsvg.c

svgsource.o: svgsource.c pluginlib.h awebsvg.h xmlparse.h ezlists.h svgtext.h
   $(CC) svgsource.c

svgcopy.o: svgcopy.c pluginlib.h awebsvg.h
   $(CC) svgcopy.c

# svgtext.o: optional ttengine.library based text renderer.  Compiled
# unconditionally; the runtime check on TTEngineAvail / TTEngineBase
# makes the module a no-op when ttengine.library is missing on the
# user's system.  No SAS/C pragma link is needed because the pragma
# header generates calls through the global TTEngineBase pointer.
svgtext.o: svgtext.c pluginlib.h awebsvg.h svgtext.h xmlparse.h
   $(CC) svgtext.c

xmlparse.o: xmlparse.c xmlparse.h
   $(CC) xmlparse.c

# Clean targets
clean:
   $(RM) *.o

cleanall: clean
   $(RM) awebsvg.awebplugin

install: awebsvg.awebplugin
   - copy clone awebsvg.awebplugin TO //Internet/AWeb/awebplugin/awebsvg.awebplugin

